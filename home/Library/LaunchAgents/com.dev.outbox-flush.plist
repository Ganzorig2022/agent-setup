<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dev.outbox-flush</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/dev/.local/bin/outbox-flush.py</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/dev/Library/Logs/outbox-flush.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dev/Library/Logs/outbox-flush.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
